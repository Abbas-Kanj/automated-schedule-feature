# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Claude: CLAUDE.md and .claude/handoff/ are checked in — they're shared
# project context, not machine state. Everything else under .claude/
# (local settings, permissions, lock files) stays local. Note the pattern
# has to ignore the directory's *contents* (`.claude/*`), not the
# directory itself: git can't re-include a path under an ignored dir.
.claude/*
!.claude/handoff/

# graphify knowledge-graph output (generated, rebuild with `/graphify .`)
graphify-out

.env

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

