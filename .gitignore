# the actual task/result/log content.
bridge/.claude-hook-state.json
bridge/alerts.jsonl
bridge/notifications.jsonl
bridge/agents/*/inbox/*
bridge/agents/*/outbox/*
bridge/agents/*/pending/*
!bridge/agents/*/inbox/.keep
!bridge/agents/*/outbox/.keep
!bridge/agents/*/pending/.keep

.env

